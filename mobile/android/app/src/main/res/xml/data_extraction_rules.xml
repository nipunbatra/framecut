<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The refresh token is a live credential and the
  cache holds multi-gigabyte video, so neither cloud backup nor device transfer
  should copy any of it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
